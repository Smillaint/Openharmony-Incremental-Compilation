+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import("//build/ohos.gni")
+
+# Preserve module metadata while copying each payload file explicitly.
+template("copy_arkts_sdk_files") {
+  _name = target_name
+  _copy_target = "${_name}_files"
+  action(_copy_target) {
+    deps = invoker.deps
+    script = "//developtools/ace_ets2bundle/sdk_files.py"
+    inputs = [ invoker.manifest ]
+    _state = "$target_out_dir/${target_name}.json"
+    outputs = [ _state ]
+    foreach(file, invoker.files) {
+      if (file != "package.json") {
+        inputs += [ "${invoker.source_dir}/$file" ]
+        outputs += [ "${invoker.output_dir}/$file" ]
+      }
+    }
+    args = [
+      "copy",
+      rebase_path(invoker.manifest, root_build_dir),
+      rebase_path(invoker.source_dir, root_build_dir),
+      rebase_path(invoker.output_dir, root_build_dir),
+      rebase_path(_state, root_build_dir),
+    ]
+  }
+  ohos_copy(_name) {
+    deps = [ ":$_copy_target" ]
+    sources = [ "${invoker.source_dir}/package.json" ]
+    outputs = [ "${invoker.output_dir}/package.json" ]
+    forward_variables_from(invoker,
+                           [
+                             "module_source_dir",
+                             "module_install_name",
+                           ])
+    subsystem_name = "developtools"
+    part_name = "ace_ets2bundle"
+  }
+}
diff --git a/sdk_files.py b/sdk_files.py
new file mode 100644
index 000000000..e07e1df93
--- /dev/null
+++ b/sdk_files.py
@@ -0,0 +1,148 @@
+# Copyright (c) 2026 Huawei Device Co., Ltd.
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Describe and publish the concrete files in the ArkTS SDK helpers."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import tempfile
+
+
+RUNTIME_DEPS = ('ajv', 'fast-deep-equal', 'fast-uri', 'json-schema-traverse',
+                'require-from-string', 'json5')
+
+
+def files_under(directory, excluded=()):
+    for root, directories, files in os.walk(directory):
+        directories[:] = sorted(d for d in directories if d not in excluded)
+        for name in sorted(files):
+            path = Path(root) / name
+            if path.is_file():
+                yield path
+
+
+def describe(kind, source):
+    source = Path(source).resolve()
+    copies = {'package.json': source / 'package.json'}
+    inputs = {source / 'package.json', source / 'babel.config.js'}
+    generated = set()
+    if kind == 'plugins':
+        inputs.add(source / 'custom-import-plugin.js')
+        for path in files_under(source, ('node_modules', 'lib', 'test', '.git')):
+            relative = path.relative_to(source)
+            if path.suffix == '.ts' and relative.as_posix() != 'jest-test.config.ts':
+                inputs.add(path)
+                generated.add('lib/' + relative.with_suffix('.js').as_posix())
+        for folder, destination in [('components', 'lib/components'),
+                                    ('insight_intents/schema', 'lib/insight_intents/schema')]:
+            base = source.parent / 'compiler' / folder
+            for path in files_under(base):
+                copies[destination + '/' + path.relative_to(base).as_posix()] = path
+        for dependency in RUNTIME_DEPS:
+            base = source / 'node_modules' / dependency
+            if not base.is_dir():
+                base = source.parent / 'compiler/node_modules' / dependency
+            if not base.is_dir():
+                raise FileNotFoundError('Missing SDK runtime dependency: ' + dependency)
+            for path in files_under(base):
+                copies['node_modules/' + dependency + '/' + path.relative_to(base).as_posix()] = path
+    elif kind == 'wrapper':
+        inputs.update([source / 'tsconfig.json', source / 'koalaui-transform.js'])
+        for path in files_under(source / 'src'):
+            inputs.add(path)
+            if path.suffix == '.ts':
+                generated.add('build/lib/' + path.relative_to(source / 'src').with_suffix('.js').as_posix())
+        for path in files_under(source / 'koalaui'):
+            copies['koalaui/' + path.relative_to(source / 'koalaui').as_posix()] = path
+        generated.add('build/native/es2panda.node')
+    else:
+        raise ValueError('Unknown SDK helper: ' + kind)
+    inputs.update(copies.values())
+    # Track tool files, including symlinked executables, without directory mtimes.
+    inputs.update(files_under(source / 'node_modules'))
+    lockfile = source / 'package-lock.json'
+    if lockfile.is_file():
+        inputs.add(lockfile)
+    return inputs, generated, copies
+
+
+def publish(source, destination, names, state_file):
+    source, destination = Path(source).resolve(), Path(destination).resolve()
+    names = sorted(set(names))
+    for name in names:
+        relative = Path(name)
+        if relative.is_absolute() or '..' in relative.parts:
+            raise ValueError('Invalid SDK output: ' + name)
+        if not (source / relative).is_file():
+            raise FileNotFoundError('Missing declared SDK output: ' + str(source / relative))
+        (destination / relative).resolve().relative_to(destination)
+    state_file = Path(state_file)
+    previous = json.loads(state_file.read_text(encoding='utf-8')) if state_file.is_file() else []
+    for name in names:
+        src, dst = source / name, destination / name
+        if dst.is_file() and src.read_bytes() == dst.read_bytes():
+            continue
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        with tempfile.NamedTemporaryFile(dir=dst.parent, delete=False) as temporary:
+            pending = Path(temporary.name)
+        try:
+            shutil.copy2(src, pending)
+            # A changed output must be newer even when the input carries an old mtime.
+            os.utime(pending, None)
+            os.replace(pending, dst)
+        finally:
+            pending.unlink(missing_ok=True)
+    for name in set(previous) - set(names):
+        path = destination / name
+        path.resolve().relative_to(destination)
+        if path.is_file():
+            path.unlink()
+    content = json.dumps(names, indent=2) + '\n'
+    state_file.parent.mkdir(parents=True, exist_ok=True)
+    if not state_file.is_file() or state_file.read_text(encoding='utf-8') != content:
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=state_file.parent,
+                                         delete=False) as temporary:
+            temporary.write(content)
+            pending = Path(temporary.name)
+        os.replace(pending, state_file)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    sub = parser.add_subparsers(dest='command', required=True)
+    manifest = sub.add_parser('manifest')
+    manifest.add_argument('kind', choices=('plugins', 'wrapper'))
+    manifest.add_argument('source')
+    manifest.add_argument('root')
+    copy = sub.add_parser('copy')
+    copy.add_argument('manifest')
+    copy.add_argument('source')
+    copy.add_argument('destination')
+    copy.add_argument('state')
+    args = parser.parse_args()

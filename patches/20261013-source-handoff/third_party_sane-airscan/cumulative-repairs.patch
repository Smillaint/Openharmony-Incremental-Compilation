+def run_patch(patch_path, work_dir, reverse=False, dry_run=False):
+    command = [
+        'patch',
+        '-p1',
+        '--fuzz=0',
+        '--no-backup-if-mismatch',
+        '--force',
+        '-i',
+        patch_path,
+        '-d',
+        work_dir,
     ]
+    command.append('--reverse' if reverse else '--forward')
+    if dry_run:
+        command.append('--dry-run')
+    return subprocess.run(command, text=True, capture_output=True)
+
+
+def apply_patch(patch_path, work_dir):
+    reverse_check = run_patch(patch_path, work_dir, reverse=True, dry_run=True)
+    if reverse_check.returncode == 0:
+        return
+
+    forward_check = run_patch(patch_path, work_dir, dry_run=True)
+    if forward_check.returncode != 0:
+        raise RuntimeError(
+            '{} does not apply cleanly:\n{}'.format(
+                patch_path, forward_check.stdout + forward_check.stderr
+            )
+        )
+    result = run_patch(patch_path, work_dir)
+    result.check_returncode()
+
+

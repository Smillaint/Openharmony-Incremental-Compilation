From 8334993c47ae5d557f4f47b74b942103d94a37cc Mon Sep 17 00:00:00 2001
From: Smillick <3185479846@qq.com>
Date: Wed, 14 Oct 2026 16:14:05 +0800
Subject: [PATCH] Stabilize sa_profile_src_phone incremental inputs and output

Sort source SA metadata and preserve unchanged JSON outputs.
Split the source-SA portion of build PR #6965; relates to build issue #4657.

Signed-off-by: Smillick <3185479846@qq.com>
---
 ohos/sa_profile/sa_profile_source.py      |  3 ++-
 ohos/sa_profile/src_sa_profile_process.py |  6 ++++--
 scripts/util/file_utils.py                | 16 +++-------------
 3 files changed, 9 insertions(+), 16 deletions(-)

diff --git a/ohos/sa_profile/sa_profile_source.py b/ohos/sa_profile/sa_profile_source.py
index eae14b2d7..40b054ee6 100755
--- a/ohos/sa_profile/sa_profile_source.py
+++ b/ohos/sa_profile/sa_profile_source.py
@@ -60,7 +60,8 @@ def main():
     src_parts_info = get_src_parts(args.system_install_info_file)
     sa_install_infos = get_sa_install_info(args.src_sa_info_file,
                                            src_parts_info)
-    write_json_file(args.src_sa_install_info_file, sa_install_infos)
+    write_json_file(args.src_sa_install_info_file, sa_install_infos,
+                    check_changes=True)
     return 0
 
 
diff --git a/ohos/sa_profile/src_sa_profile_process.py b/ohos/sa_profile/src_sa_profile_process.py
index 69389e167..d5ced17ef 100755
--- a/ohos/sa_profile/src_sa_profile_process.py
+++ b/ohos/sa_profile/src_sa_profile_process.py
@@ -43,7 +43,8 @@ def sa_info_process(sa_profile_infos_file: str, toolchain_platform: dict):
         _sa_info['part_name'] = part_name
         _sa_info['origin_part_name'] = origin_part_name
         processed_sa_infos.append(_sa_info)
-    return processed_sa_infos
+    return sorted(processed_sa_infos,
+                  key=lambda info: info.get('label', ''))
 
 
 def main():
@@ -62,7 +63,8 @@ def main():
     toolchain_platform = variants_toolchain_info.get('toolchain_platform')
     processed_sa_infos = sa_info_process(args.sa_profile_infos_file,
                                          toolchain_platform)
-    write_json_file(args.output_file, processed_sa_infos)
+    write_json_file(args.output_file, processed_sa_infos,
+                    check_changes=True)
     build_utils.write_depfile(args.depfile, args.output_file, depfiles)
     return 0
 
diff --git a/scripts/util/file_utils.py b/scripts/util/file_utils.py
index 65dcb4af9..4b0ac9e40 100755
--- a/scripts/util/file_utils.py
+++ b/scripts/util/file_utils.py
@@ -16,7 +16,6 @@
 import json
 import os
 import subprocess
-import hashlib
 import platform
 
 
@@ -82,18 +81,9 @@ def write_json_file(output_file, content, check_changes=False):
 
 
 def __check_changes(output_file, content):
-    if os.path.exists(output_file) and os.path.isfile(output_file):
-        # file content md5 val
-        sha256_obj = hashlib.sha256()
-        sha256_obj.update(str(read_json_file(output_file)).encode())
-        hash_value = sha256_obj.hexdigest()
-        # new content md5 val
-        sha256_obj_new = hashlib.sha256()
-        sha256_obj_new.update(str(content).encode())
-        hash_value_new = sha256_obj_new.hexdigest()
-        if hash_value_new == hash_value:
-            return False
-    return True
+    if not os.path.isfile(output_file):
+        return True
+    return read_json_file(output_file) != content
 
 
 # Write file data

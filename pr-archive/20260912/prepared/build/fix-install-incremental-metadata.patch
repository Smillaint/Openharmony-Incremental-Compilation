---
 ohos/packages/modules_install.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ohos/packages/modules_install.py b/ohos/packages/modules_install.py
index 9f42515f..5c36e291 100755
--- a/ohos/packages/modules_install.py
+++ b/ohos/packages/modules_install.py
@@ -343,7 +343,7 @@ def main():
     if os.path.exists(args.system_image_zipfile):

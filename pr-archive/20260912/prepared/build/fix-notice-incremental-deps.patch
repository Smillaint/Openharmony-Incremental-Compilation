Subject: [PATCH 1/2] Find module licenses at the source tree boundary

Signed-off-by: Smillick <3185479846@qq.com>
---
 ohos/notice/collect_module_notice_file.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ohos/notice/collect_module_notice_file.py b/ohos/notice/collect_module_notice_file.py
index af841a5f..92d29ebb 100755
--- a/ohos/notice/collect_module_notice_file.py
+++ b/ohos/notice/collect_module_notice_file.py
@@ -59,12 +59,12 @@ def find_other_files(license_file_path):
 
 
 def find_file_recursively(current_dir: str, target_files: list):
-    if is_top_dir(current_dir):
-        return None
     for file in target_files:
         candidate = os.path.join(current_dir, file)
         if os.path.isfile(candidate):
             return candidate
+    if is_top_dir(current_dir):
+        return None
     return find_file_recursively(os.path.dirname(current_dir), target_files)
 
 


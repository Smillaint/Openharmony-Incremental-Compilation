          "resolved": false,
          "matches": [
            {
              "id": 194781199,
              "body": "单参数 `rebase_path` 会把 `src_idl` 转成系统绝对路径，再次转换不会改变路径。让单文件输入与 `sources` 多文件输入保持一致，避免后续脚本按工具目录解析相对路径。",
              "created_at": "2026-10-20T17:22:46+08:00",
              "updated_at": "2026-10-20T17:22:46+08:00",
              "user": {
                "id": "67150ce628c7754a02de123a",
